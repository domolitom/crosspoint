node_modules/
out/

# Footage is a build artifact of `npm run capture` — megabytes of it, regenerable from the
# app in one command, and stale the moment the canvas changes.
public/*.webm
public/*.mp4

# `changes.json` is deliberately NOT ignored. The feed scene imports it at build time, so
# without it `npm run render` fails on a clean checkout — and it is the one piece of the
# recording that is small, meaningful, and worth reading in a diff.
