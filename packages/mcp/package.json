{
  "name": "@crosspoint/mcp",
  "version": "0.4.0",
  "license": "MIT",
  "description": "MCP server for Crosspoint — lets an agent read and edit a diagram it cannot move.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diagram",
    "graph",
    "agent",
    "claude"
  ],
  "homepage": "https://github.com/domolitom/crosspoint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domolitom/crosspoint.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/domolitom/crosspoint/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "crosspoint-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "crosspoint": ">=0.2.0",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
